{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Fantasy Hockey Stats chart values",
  "type": "object",
  "properties": {
    "api": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "description": "SQLite uses a single-writer ReadWriteOnce volume."
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "size": { "type": "string" }
      }
    },
    "seasonImport": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "seasonIds": {
          "type": "array",
          "items": { "type": ["string", "integer"] }
        },
        "backoffLimit": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
